---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import { htmlLang, idiomas, nombresIdioma, t, tr, url, type Lang } from '../i18n';
import { rayosSol, DISCO_SOL } from '../lib/sol';
import ayuda from '../data/ayuda.json';

interface Props {
  lang: Lang;
  /** Ruta de esta página sin idioma ni barra inicial: '' para la portada, 'el-calafate/' para una ficha. */
  ruta: string;
  titulo: string;
  descripcion: string;
  imagen?: string;
  /** Para la página 404: sin dirección oficial ni versiones en otros idiomas, y fuera de Google. */
  sinIndexar?: boolean;
  /** Datos estructurados (schema.org) para buscadores: no se ven en la página. */
  datos?: Record<string, unknown>;
}
const { lang, ruta, titulo, descripcion, imagen, sinIndexar, datos } = Astro.props;
const x = t(lang);
const sitio = Astro.site;
const absoluta = (l: Lang) => (sitio ? new URL(url(l, ruta), sitio).href : url(l, ruta));
const imagenAbs = imagen && sitio && imagen.startsWith('/') ? new URL(imagen, sitio).href : imagen;
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {sinIndexar ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={absoluta(lang)} />
        {idiomas.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={absoluta(l)} />)}
        <link rel="alternate" hreflang="x-default" href={absoluta('es')} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={x.marca.join(' ')} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    {imagenAbs && <meta property="og:image" content={imagenAbs} />}
    <meta name="twitter:card" content="summary_large_image" />
    {datos && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...(imagenAbs ? { image: imagenAbs } : {}), ...datos, url: absoluta(lang), inLanguage: htmlLang[lang] }).replace(/</g, '\\u003c')}></script>
    )}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f6f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d161c" media="(prefers-color-scheme: dark)" />
    <script is:inline src="/tema.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{x.saltar}</a>
    <header class="sitio-barra">
      <div class="barra-in">
        <a class="marca" href={url(lang)}><svg class="sol" viewBox="-100 -100 200 200" width="22" height="22" fill="#f6b40e" aria-hidden="true"><path d={rayosSol} /><circle r={DISCO_SOL} /></svg>{x.marca[0]} <span>{x.marca[1]}</span></a>
        <div class="barra-der">
          <nav aria-label={x.nav.destinos}>
            <a href={`${url(lang)}#mapa`}>{x.nav.mapa}</a>
            <a href={`${url(lang)}#calendario`}>{x.nav.calendario}</a>
            <a href={`${url(lang)}#destinos`}>{x.nav.destinos}</a>
            <a href={`${url(lang)}#provincias`}>{x.provincia.seccion.etiqueta}</a>
            <a href={`${url(lang)}#fuentes`}>{x.nav.fuentes}</a>

          </nav>
          <div class="herramientas">
          <button type="button" class="boton-ayuda" popovertarget="ayuda-urgente">
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
              <span>{x.ayuda.boton}</span>
            </button>
          <button type="button" class="boton-idioma" popovertarget="menu-idioma" aria-label={`${x.nav.idioma}: ${nombresIdioma[lang]}`}>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></g></svg>
            {lang.toUpperCase()}
            <svg class="flecha-idioma" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <ul id="menu-idioma" popover class="idiomas" aria-label={x.nav.idioma}>
            {idiomas.map((l) => (
              <li>
                <a href={url(l, ruta)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === lang ? 'page' : undefined}>
                  <span class="cod">{l.toUpperCase()}</span> {nombresIdioma[l]}
                </a>
              </li>
            ))}
          </ul>
          <button type="button" class="boton-tema" data-tema data-a-claro={x.tema.claro} data-a-oscuro={x.tema.oscuro} aria-label={x.tema.oscuro} title={x.tema.oscuro}>
            <svg class="sol" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
            <svg class="luna" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
          </button>
          </div>
        </div>
      </div>
    </header>
    <div id="ayuda-urgente" popover class="ayuda-urgente" aria-labelledby="ayuda-titulo">
      <div class="ayuda-cab">
        <h2 id="ayuda-titulo">{x.ayuda.titulo}</h2>
        <button type="button" popovertarget="ayuda-urgente" popovertargetaction="hide" aria-label={x.ayuda.cerrar}>×</button>
      </div>
      <p class="ayuda-texto">{x.ayuda.texto}</p>
      <ul class="ayuda-lista">
        {ayuda.numeros.map((n) => (
          <li class={n.principal ? 'principal' : ''}>
            <a href={`tel:${n.numero}`} aria-label={`${x.ayuda.llamar(n.numero)}: ${tr(n.que, lang)}`}>
              <span class="num">{n.numero}</span>
              <span class="que">{tr(n.que, lang)}{n.nota && <small>{tr(n.nota, lang)}</small>}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="ayuda-pie">{x.ayuda.consejo} <a href={ayuda.fuente} target="_blank" rel="noopener">{x.ayuda.fuente}</a></p>
    </div>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="envoltura pie-in">
        <div class="pie-marca">
          <a class="marca" href={url(lang)}><svg class="sol" viewBox="-100 -100 200 200" width="22" height="22" fill="#f6b40e" aria-hidden="true"><path d={rayosSol} /><circle r={DISCO_SOL} /></svg>{x.marca[0]} <span>{x.marca[1]}</span></a>
          <p class="autor">
          {x.hechoPor} <strong>Nicolás Chandia</strong>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/nicolas-chandia" rel="author noopener" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            LinkedIn
          </a>
        </p>
        </div>
        <nav class="pie-nav" aria-label={x.nav.destinos}>
          <a href={`${url(lang)}#mapa`}>{x.nav.mapa}</a>
          <a href={`${url(lang)}#calendario`}>{x.nav.calendario}</a>
          <a href={`${url(lang)}#destinos`}>{x.nav.destinos}</a>
          <a href={`${url(lang)}#provincias`}>{x.provincia.seccion.etiqueta}</a>
          <a href={`${url(lang)}#fuentes`}>{x.nav.fuentes}</a>
        </nav>
        <p class="pie-datos">{x.pie}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Concepto: el país leído de norte a sur, como una ruta. Fotos a sangre que invitan,
     y entre foto y foto, una columna angosta con los datos de cada temporada. */
  :root {
    --papel: #f4f6f5;
    --papel-2: #e9eeee;
    --tinta: #15222b;
    --tinta-2: #4b5b66;
    --linea: #d3dcdf;
    --glaciar: #0e6b77;
    --cerro: #b24f27;
    --arena: #b58a2c;
    --celeste: #74acdf;
    --celeste-texto: #2b6aa6;
    --blanco: #ffffff;
    --sobre-foto: #ffffff;

    --f-titulo: 'Barlow Condensed', 'Arial Narrow', 'Helvetica Neue', sans-serif;
    --f-texto: 'Source Serif 4 Variable', Georgia, 'Times New Roman', serif;
    --f-dato: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;

    --ancho: 72rem;
    --gutter-izq: max(16px, env(safe-area-inset-left, 0px));
    --gutter-der: max(16px, env(safe-area-inset-right, 0px));
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --papel: #0d161c;
      --papel-2: #15212a;
      --tinta: #e6edf0;
      --tinta-2: #9cadb8;
      --linea: #26343e;
      --glaciar: #5cc0ca;
      --cerro: #e88a5e;
      --arena: #d8b45e;
      --celeste-texto: #8cc4ef;
      color-scheme: dark;
    }
  }
  :root[data-theme='light'] { color-scheme: light; }
  :root[data-theme='dark'] {
    --papel: #0d161c;
    --papel-2: #15212a;
    --tinta: #e6edf0;
    --tinta-2: #9cadb8;
    --linea: #26343e;
    --glaciar: #5cc0ca;
    --cerro: #e88a5e;
    --arena: #d8b45e;
    --celeste-texto: #8cc4ef;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--f-texto);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  img { max-width: 100%; display: block; }
  a { color: var(--celeste-texto); text-underline-offset: 0.18em; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--celeste); outline-offset: 3px; border-radius: 2px; }
  h1, h2, h3 {
    font-family: var(--f-titulo);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0.005em;
    text-wrap: balance;
    margin: 0;
  }
  .envoltura {
    max-width: var(--ancho);
    margin-inline: auto;
    padding-left: var(--gutter-izq);
    padding-right: var(--gutter-der);
  }
  .etiqueta {
    font-family: var(--f-dato);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .saltar {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--tinta);
    color: var(--papel);
    padding: 0.5rem 1rem;
    z-index: 20;
  }
  .saltar:focus { left: var(--gutter-izq); top: calc(env(safe-area-inset-top, 0px) + 8px); }

  .sitio-barra {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in oklab, var(--papel) 88%, transparent);
    backdrop-filter: blur(10px);
  }
  /* Franja celeste y blanca, como la bandera, al pie de la barra y arriba del pie de página */
  .sitio-barra::after, .pie::before {
    content: '';
    display: block;
    height: 6px;
    background: linear-gradient(var(--celeste) 0 33.3%, var(--blanco) 33.3% 66.6%, var(--celeste) 66.6%);
    box-shadow: 0 1px 0 var(--linea);
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--papel);
  }
  .barra-in {
    max-width: var(--ancho);
    margin-inline: auto;
    padding-left: var(--gutter-izq);
    padding-right: var(--gutter-der);
    padding-block: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .marca {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--tinta);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .marca span { color: var(--celeste-texto); }
  .marca { display: inline-flex; align-items: center; white-space: pre; }
  .marca .sol { width: 1.3em; height: 1.3em; flex: none; margin-right: 0.35em; fill: #f6b40e; }
  .barra-der { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .sitio-barra nav { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; }
  /* Idioma y modo: discretos, con el mismo estilo que los links de la barra. */
  .boton-idioma {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font: inherit;
    font-family: var(--f-dato);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--tinta-2);
    background: transparent;
    border: 0;
    border-radius: 3px;
    padding: 0.3rem 0.35rem;
    cursor: pointer;
  }
  .boton-idioma:hover, .boton-idioma:focus-visible { color: var(--tinta); }
  .boton-idioma .flecha-idioma { opacity: 0.7; }
  .idiomas {
    /* Menú desplegable: se abre debajo de la barra, a la derecha */
    position: fixed;
    inset: auto;
    top: calc(env(safe-area-inset-top, 0px) + 3.7rem);
    right: max(var(--gutter-der), calc((100vw - var(--ancho)) / 2 + 16px));
    margin: 0;
    list-style: none;
    padding: 0.3rem;
    min-width: 11rem;
    border: 1px solid var(--linea);
    border-radius: 4px;
    background: var(--papel);
    color: var(--tinta);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.22);
  }
  /* Cerrado no se muestra, aunque otra regla le ponga display (respaldo del atributo popover). */
  .idiomas:not(:popover-open) { display: none; }
  .idiomas a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--f-texto);
    font-size: 0.95rem;
    color: var(--tinta);
    text-decoration: none;
    padding: 0.55rem 0.7rem;
    border-radius: 3px;
  }
  .idiomas a:hover { background: var(--papel-2); }
  .idiomas .cod { font-family: var(--f-dato); font-size: 0.72rem; color: var(--tinta-2); width: 1.6rem; }
  .idiomas a[aria-current='page'] { background: var(--celeste); color: #0d1b26; }
  .idiomas a[aria-current='page'] .cod { color: #0d1b26; }
  .herramientas { display: flex; align-items: center; gap: 0.2rem; }
  .herramientas .boton-ayuda { margin-right: 0.6rem; }
  .boton-tema {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--tinta-2);
    cursor: pointer;
  }
  .boton-tema:hover, .boton-tema:focus-visible { color: var(--tinta); background: var(--papel-2); }
  .boton-tema svg { width: 16px; height: 16px; }
  /* Muestra el ícono del modo al que se pasa: luna en claro, sol en oscuro. */
  .boton-tema .sol { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .boton-tema .sol { display: block; }
    :root:not([data-theme='light']) .boton-tema .luna { display: none; }
  }
  :root[data-theme='dark'] .boton-tema .sol { display: block; }
  :root[data-theme='dark'] .boton-tema .luna { display: none; }
  /* Pantallas angostas: arriba la marca con ayuda, idioma y modo; abajo los cinco accesos en
     una sola línea (si no entran, se deslizan de costado en vez de partirse en renglones). */
  @media (max-width: 62rem) {
    .sitio-barra { position: relative; }
    .barra-in { row-gap: 0.35rem; column-gap: 0.5rem; padding-bottom: 0.45rem; }
    .barra-der { display: contents; }
    .barra-in .marca { font-size: clamp(0.85rem, 4.2vw, 1.35rem); }
    .herramientas { order: 1; gap: 0.25rem; }
    .boton-tema { width: 2.25rem; height: 2.25rem; }
    .sitio-barra nav {
      order: 2;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0.6rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-block: 0.15rem;
    }
    .sitio-barra nav::-webkit-scrollbar { display: none; }
    .sitio-barra .barra-in nav a { white-space: nowrap; font-size: clamp(0.58rem, 2.75vw, 0.72rem); letter-spacing: 0.03em; }
  }
  @media (min-width: 40.01rem) and (max-width: 62rem) {
    .sitio-barra nav { justify-content: flex-start; gap: 1.6rem; }
  }
  @media (max-width: 30rem) {
    .herramientas .boton-ayuda { margin-right: 0.15rem; }
    .boton-idioma .flecha-idioma { display: none; }
    .boton-tema { width: 2rem; height: 2rem; }
  }
  /* Muy angosto: el botón de ayuda queda solo con el ícono del teléfono. */
  @media (max-width: 24rem) {
    .boton-ayuda span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .boton-ayuda { padding: 0.35rem 0.45rem; }
  }
  .sitio-barra nav a {
    font-family: var(--f-dato);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-2);
    text-decoration: none;
  }
  .sitio-barra nav a:hover { color: var(--tinta); }
  .boton-ayuda {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font: inherit;
    font-family: var(--f-dato);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #b3261e;
    border: 0;
    border-radius: 2px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    align-self: center;
  }
  .boton-ayuda:hover { background: #8f1d17; }
  .ayuda-urgente {
    width: min(26rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--linea);
    border-top: 4px solid #b3261e;
    border-radius: 4px;
    background: var(--papel);
    color: var(--tinta);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.25);
  }
  .ayuda-urgente::backdrop { background: rgb(10 20 28 / 0.45); }
  .ayuda-cab { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .ayuda-cab h2 { margin: 0; font-size: 1.5rem; }
  .ayuda-cab button {
    font-size: 1.6rem; line-height: 1; width: 2.4rem; height: 2.4rem;
    border: 0; background: transparent; color: var(--tinta); cursor: pointer;
  }
  .ayuda-texto { margin: 0.2rem 0 0.8rem; color: var(--tinta-2); font-size: 0.95rem; }
  .ayuda-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .ayuda-lista a {
    display: grid; grid-template-columns: 3.6rem minmax(0, 1fr); gap: 0.7rem; align-items: center;
    padding: 0.45rem 0.55rem; border: 1px solid var(--linea); border-radius: 3px;
    color: var(--tinta); text-decoration: none; min-height: 44px;
  }
  .ayuda-lista a:hover { border-color: var(--celeste); }

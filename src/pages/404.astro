---
// Página para direcciones que no existen. Vercel la sirve con estado 404 para todo el sitio,
// así que el texto se cambia a portugués o inglés si la dirección empieza con /pt/ o /en/.
// Si la dirección se parece a un destino o una provincia, sugiere el link correcto.
import Base from '../layouts/Base.astro';
import { destinos } from '../data/destinos';
import provincias from '../data/provincias-info.json';

const textos = {
  es: {
    etiqueta: 'Error 404',
    titulo: 'Este lugar no está en el mapa',
    texto: 'Puede que el link esté mal escrito o que la página haya cambiado de nombre.',
    quisiste: '¿Quisiste decir',
    inicio: 'Volver al inicio',
    mapa: 'Mapa',
    destinos: 'Destinos',
    provincias: 'Provincias',
  },
  pt: {
    etiqueta: 'Erro 404',
    titulo: 'Este lugar não está no mapa',
    texto: 'Talvez o link esteja escrito errado ou a página tenha mudado de nome.',
    quisiste: 'Você quis dizer',
    inicio: 'Voltar ao início',
    mapa: 'Mapa',
    destinos: 'Destinos',
    provincias: 'Províncias',
  },
  en: {
    etiqueta: 'Error 404',
    titulo: 'This place isn’t on the map',
    texto: 'The link may be misspelled, or the page may have been renamed.',
    quisiste: 'Did you mean',
    inicio: 'Back to home',
    mapa: 'Map',
    destinos: 'Destinations',
    provincias: 'Provinces',
  },
};
const x = textos.es;
// Rutas que existen, para sugerir la más parecida a la que se escribió.
const rutas = [
  ...destinos.map((d) => ({ r: `${d.id}/`, n: { es: d.nombre.es, pt: d.nombre.pt, en: d.nombre.en } })),
  ...provincias.map((p) => ({ r: `provincia/${p.slug}/`, n: { es: p.nombre, pt: p.nombre, en: p.nombre } })),
];
---
<Base lang="es" ruta="" titulo={`${x.titulo} · Argentina todo el año`} descripcion={x.texto} sinIndexar>
  <section class="envoltura no-esta" data-no-esta data-textos={JSON.stringify(textos)} data-rutas={JSON.stringify(rutas)}>
    <p class="etiqueta" data-t="etiqueta">{x.etiqueta}</p>
    <h1 data-t="titulo">{x.titulo}</h1>
    <p class="texto" data-t="texto">{x.texto}</p>
    <p class="sugerencia" data-sugerencia hidden></p>
    <a class="boton-inicio" href="/" data-ir=""><span data-t="inicio">{x.inicio}</span> →</a>
    <nav class="atajos" aria-label="Atajos">
      <a href="/#mapa" data-ir="#mapa" data-t="mapa">{x.mapa}</a>
      <a href="/#destinos" data-ir="#destinos" data-t="destinos">{x.destinos}</a>
      <a href="/#provincias" data-ir="#provincias" data-t="provincias">{x.provincias}</a>
    </nav>
  </section>
</Base>

<script>
  const caja = document.querySelector<HTMLElement>('[data-no-esta]');
  if (caja) {
    const partes = location.pathname.split('/').filter(Boolean);
    const lang = partes[0] === 'pt' || partes[0] === 'en' ? partes[0] : 'es';
    const pre = lang === 'es' ? '/' : `/${lang}/`;
    const tx = JSON.parse(caja.dataset.textos || '{}')[lang];
    if (lang !== 'es') {
      document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
      caja.querySelectorAll<HTMLElement>('[data-t]').forEach((el) => (el.textContent = tx[el.dataset.t!]));
      document.title = `${tx.titulo} · Argentina todo el año`;
    }
    caja.querySelectorAll<HTMLAnchorElement>('[data-ir]').forEach((a) => (a.href = pre + a.dataset.ir));

    // La ruta más parecida (distancia de edición), solo si la diferencia es chica.
    const pedido = (lang === 'es' ? partes : partes.slice(1)).join('/').toLowerCase();
    const distancia = (a: string, b: string) => {
      const d = Array.from({ length: b.length + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        let prev = d[0];
        d[0] = i;
        for (let j = 1; j <= b.length; j++) {
          const t = d[j];
          d[j] = Math.min(d[j] + 1, d[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
          prev = t;
        }
      }
      return d[b.length];
    };
    if (pedido) {
      const rutas: { r: string; n: Record<string, string> }[] = JSON.parse(caja.dataset.rutas || '[]');
      const limpia = (s: string) => s.replace(/\/$/, '');
      let mejor = { r: '', n: {} as Record<string, string>, d: Infinity };
      for (const r of rutas) {
        const dd = Math.min(distancia(pedido, limpia(r.r)), distancia(pedido, limpia(r.r).replace('provincia/', '')));
        if (dd < mejor.d) mejor = { ...r, d: dd };
      }
      if (mejor.d <= Math.max(2, Math.floor(pedido.length / 4))) {
        const s = caja.querySelector<HTMLElement>('[data-sugerencia]')!;
        const a = document.createElement('a');
        a.href = pre + mejor.r;
        a.textContent = mejor.n[lang] ?? mejor.n.es;
        s.append(`${tx.quisiste} `, a, '?');
        s.hidden = false;
      }
    }
  }
</script>

<style>
  .no-esta { padding-block: clamp(4rem, 14vh, 9rem) 2rem; max-width: 46rem; }
  h1 { font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; margin: 0.5rem 0 1rem; }
  .texto { color: var(--tinta-2); font-size: 1.1rem; margin: 0 0 1.4rem; max-width: 36rem; }
  .sugerencia { font-size: 1.15rem; margin: 0 0 1.6rem; }
  .sugerencia :global(a) { font-weight: 600; }
  .boton-inicio {
    display: inline-block;
    font-family: var(--f-dato);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--papel);
    background: var(--tinta);
    padding: 0.85rem 1.3rem;
    border-radius: 2px;
  }
  .boton-inicio:hover { opacity: 0.88; }
  .atajos { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin-top: 1.6rem; }
  .atajos a {
    font-family: var(--f-dato);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
</style>

---
import Inicio from '../../components/Inicio.astro';
import { idiomaPorDefecto, idiomas, type Lang } from '../../i18n';

export function getStaticPaths() {
  return idiomas.filter((l) => l !== idiomaPorDefecto).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<Inicio lang={lang} />
